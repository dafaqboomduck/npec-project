# 1. Dependencies
FROM python:3.11-slim AS deps
WORKDIR /app

# Make pip patient with large downloads
ENV PIP_DEFAULT_TIMEOUT=600 \
    PIP_RETRIES=10

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    libgl1 \
    libglib2.0-0 \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/cv.txt requirements/cv.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements/cv.txt

COPY requirements/api.txt requirements/api.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements/api.txt

# 2. Runtime
FROM python:3.11-slim AS runtime
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=deps /usr/local/lib/python3.11/site-packages \
    /usr/local/lib/python3.11/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin

# Install npec_cv as an editable install pointing at /app/npec_cv.
COPY src/npec_cv/ ./npec_cv/
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -e ./npec_cv --no-deps

# Application source
COPY api/ ./api/
COPY lineage/ ./lineage/
COPY scripts/*.py /app/scripts/

# Non-root user
RUN adduser --disabled-password --gecos "" --uid 1001 appuser \
    && mkdir -p /tmp/npec_masks /tmp/npec_annotation_masks \
    && chown -R appuser:appuser /tmp/npec_masks /tmp/npec_annotation_masks /app/npec_cv

USER appuser

# Runtime configuration
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    USE_MOCK_INFERENCE=false

EXPOSE 8000

# Liveness check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health')"

# The compose file overrides this with --reload for live development.
CMD ["uvicorn", "api.src.main:app", "--host", "0.0.0.0", "--port", "8000"]

# 3. Cloud
# Extends the runtime target with Azure dependencies and cloud defaults.
# Build with: docker build --target cloud -t cv5-api:cloud .
FROM runtime AS cloud

# Switch to root temporarily to install cloud dependencies
USER root

COPY config.json /app/config.json
COPY /environments/ /app/environments/

COPY requirements/cloud.txt requirements/cloud.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements/cloud.txt

# Back to non-root
USER appuser

# Cloud defaults - override any of these at runtime via env vars or Key Vault
ENV DEPLOYMENT_ENV=cloud \
    STORAGE_BACKEND=minio \
    USE_MOCK_INFERENCE=false