# 1. Dependencies
FROM python:3.11-slim AS deps

WORKDIR /app

# Make pip patient with large downloads (tensorflow is ~620 MB)
ENV PIP_DEFAULT_TIMEOUT=600 \
    PIP_RETRIES=10

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    libgl1 \
    libglib2.0-0 \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/api.txt requirements/api.txt

RUN pip install --no-cache-dir -r requirements/api.txt

COPY src/npec_cv/ ./npec_cv/
RUN pip install ./npec_cv

# RUN pip install --no-cache-dir --index-url https://test.pypi.org/simple/ --extra-index-url https://pypi.org/simple/ npec-cv

# Download models using BuildKit secret
# Download models — token passed as build arg
# ARG GITHUB_TOKEN
# RUN GITHUB_TOKEN="$GITHUB_TOKEN" \
#     NPEC_MODELS_CACHE_DIR=/app/.cache/npec_cv/models \
#     npec-cv download-models

# 2. Runtime
FROM python:3.11-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=deps /usr/local/lib/python3.11/site-packages \
    /usr/local/lib/python3.11/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin

# Application source
COPY api/ ./api/
COPY src/npec_cv/ ./npec_cv/
COPY lineage/ ./lineage/
COPY scripts/train_local_and_report.py /app/scripts/train_and_report.py 

# Non-root user
RUN adduser --disabled-password --gecos "" --uid 1001 appuser \
    && mkdir -p /tmp/npec_masks /tmp/npec_annotation_masks \
    && chown -R appuser:appuser /tmp/npec_masks /tmp/npec_annotation_masks

USER appuser

# Runtime configuration
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    USE_MOCK_INFERENCE=false

EXPOSE 8000

# Liveness check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health')"
CMD ["uvicorn", "api.src.main:app", "--host", "0.0.0.0", "--port", "8000"]