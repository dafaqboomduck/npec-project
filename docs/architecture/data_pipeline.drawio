        <mxCell id="lane-azure" parent="1" style="swimlane;horizontal=0;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" value="Azure ML workspace" vertex="1">
          <mxGeometry height="700" width="1120" x="560" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;arcSize=10" value="&lt;b&gt;1. Raw HADES/NPEC data&lt;/b&gt;&lt;br&gt;&lt;br&gt;685 PNG images (4202×3006 or 4112×3006, RGBA)&lt;br&gt;1592 TIFF masks ({0,1} binary)&lt;br&gt;Cohorts: Y2B_23 / Y2B_24 / Y2B_25&lt;br&gt;24.5 GB on file share&lt;br&gt;&lt;br&gt;&lt;i&gt;see data_inventory.md&lt;/i&gt;" vertex="1">
          <mxGeometry height="130" width="420" x="80" y="160" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;arcSize=10" value="&lt;b&gt;2. Upload script&lt;/b&gt;&lt;br&gt;&lt;br&gt;scripts/upload_to_azureml.py&lt;br&gt;&lt;br&gt;walks Y2B_23 / Y2B_24 / Y2B_25&lt;br&gt;skips Kaggle/ and the .txt file&lt;br&gt;preserves folder structure exactly&lt;br&gt;&lt;br&gt;&lt;b&gt;NO transformation:&lt;/b&gt; no crop, no resize,&lt;br&gt;no alpha drop, no class filter, no split&lt;br&gt;&lt;br&gt;auth: service principal&lt;br&gt;SDK: azure-ai-ml" vertex="1">
          <mxGeometry height="220" width="420" x="80" y="340" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=center" value="&lt;b&gt;3. Azure Blob Storage&lt;/b&gt;&lt;br&gt;&lt;br&gt;workspace default datastore&lt;br&gt;&lt;br&gt;1:1 mirror of the raw delivery,&lt;br&gt;original folder structure intact" vertex="1">
          <mxGeometry height="140" width="240" x="600" y="160" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;arcSize=10" value="&lt;b&gt;4. Registered data asset&lt;/b&gt;&lt;br&gt;&lt;br&gt;cv5_hades_raw v1.0.0&lt;br&gt;&lt;br&gt;is_raw=true, no preprocessing&lt;br&gt;&lt;br&gt;&lt;i&gt;see versioning_strategy.md&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="240" x="600" y="340" as="geometry" />
        </mxCell>
        <mxCell id="n-tags" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;arcSize=10;dashed=1" value="&lt;b&gt;Tags applied at registration&lt;/b&gt;&lt;br&gt;&lt;br&gt;source, cohorts, is_raw, num_images,&lt;br&gt;num_masks, created_by, created_date,&lt;br&gt;git_commit, excluded_paths" vertex="1">
          <mxGeometry height="120" width="240" x="600" y="520" as="geometry" />
        </mxCell>
        <mxCell id="train-group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;verticalAlign=top;dashed=1" value="Training pipeline (owned separately, out of this doc&#39;s scope)" vertex="1">
          <mxGeometry height="620" width="760" x="900" y="160" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;arcSize=10" value="&lt;b&gt;5a. Filter to root masks&lt;/b&gt;&lt;br&gt;&lt;br&gt;keep _root_mask.tif&lt;br&gt;drop shoot/seed/occluded_root&lt;br&gt;&lt;br&gt;→ 492 image/root-mask pairs" vertex="1">
          <mxGeometry height="120" width="240" x="930" y="200" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;arcSize=10" value="&lt;b&gt;5b. Drop alpha&lt;/b&gt;&lt;br&gt;&lt;br&gt;RGBA → RGB&lt;br&gt;(images only)" vertex="1">
          <mxGeometry height="120" width="220" x="1200" y="200" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;arcSize=10" value="&lt;b&gt;5c. Petri-dish crop&lt;/b&gt;&lt;br&gt;&lt;br&gt;src/npec_cv/helpers/&lt;br&gt;extract_petri_dish.py&lt;br&gt;&lt;br&gt;same crop applied to mask&lt;br&gt;(nearest-neighbour)&lt;br&gt;&lt;br&gt;→ ~2K aligned image + mask" vertex="1">
          <mxGeometry height="180" width="200" x="1450" y="200" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;arcSize=10" value="&lt;b&gt;5d. Train/val/test split&lt;/b&gt;&lt;br&gt;&lt;br&gt;70/15/15 by image&lt;br&gt;seed = 42&lt;br&gt;all cohorts pooled&lt;br&gt;Y2B_23 original split discarded&lt;br&gt;&lt;br&gt;→ ~344 / 74 / 74" vertex="1">
          <mxGeometry height="160" width="240" x="930" y="430" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;arcSize=10" value="&lt;b&gt;5e. Patchify&lt;/b&gt;&lt;br&gt;&lt;br&gt;src/npec_cv/helpers/&lt;br&gt;patchify.py&lt;br&gt;&lt;br&gt;512×512 windows&lt;br&gt;stride: training pipeline&#39;s call" vertex="1">
          <mxGeometry height="160" width="220" x="1200" y="430" as="geometry" />
