        <mxCell id="n10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;arcSize=10" value="&lt;b&gt;5f. Training + validation&lt;/b&gt;&lt;br&gt;&lt;br&gt;mask patches → model&lt;br&gt;(binary segmentation)&lt;br&gt;&lt;br&gt;image patches → overlay&lt;br&gt;at validation only&lt;br&gt;&lt;br&gt;baseline:&lt;br&gt;root_det_model_512px.keras" vertex="1">
