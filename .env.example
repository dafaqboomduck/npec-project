# CV5 — example environment file
#
# Copy this file to `.env` and fill in the values for your environment.
# `.env` is gitignored — never commit real credentials.
#
# The same variable is read by:
#   - the backend (via db/session.py)
#   - Alembic migrations (via db/alembic/env.py)
# Changing DATABASE_URL switches the database with no code changes.

# --- Local (bare metal) ---
# Postgres running on your host, default port:
# DATABASE_URL=postgresql+psycopg://cv5:cv5@localhost:5432/cv5

# --- Docker Compose ---
# Host is the Postgres service name from docker-compose.yml:
DATABASE_URL=postgresql+psycopg://cv5:cv5@db:5432/cv5

# --- Portainer / on-premise ---
# Replace `db.internal` with your actual host. Use a strong password and
# consider loading the value from a secret store rather than a .env file.
# DATABASE_URL=postgresql+psycopg://cv5:${DB_PASSWORD}@db.internal:5432/cv5

# ---------------------------------------------------------------------------
# Docker Compose variables
# ---------------------------------------------------------------------------
# These are used only by docker-compose.yml to configure the `db` service.
# Application code never reads these directly — it reads DATABASE_URL.
POSTGRES_USER=cv5
POSTGRES_PASSWORD=cv5
POSTGRES_DB=cv5
# Override if port 5432 is already in use on your host:
POSTGRES_HOST_PORT=5432
