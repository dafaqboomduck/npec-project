# DATABASE

# Full SQLAlchemy connection string for the PostgreSQL database.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://myuser:mypassword@db:5432/cv5db

# PostgreSQL credentials — must match the values in DATABASE_URL above.
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=cv5db

# Host port that PostgreSQL is exposed on (used by Docker Compose port mapping).
POSTGRES_HOST_PORT=5432

# AUTH / JWT

# Secret key used to sign JWT access tokens. Use a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-secret

# Hashing algorithm for JWT signing. HS256 is the default.
ALGORITHM=HS256

# INFERENCE

# Set to "true" to return mock predictions instead of running the real model.
# Useful for local development and CI where the model weights are not present.
USE_MOCK_INFERENCE=true

# Set to "minio" to use MinIO storage, "local" to use file:// uris
# Set to "local" for development only, frontend cannot fetch these)
STORAGE_BACKEND=minio

# MODEL / ARTIFACT PATHS

# Input image storage
INPUT_STORAGE_PATH=./data/inputs
 
# Segmentation mask storage
MASK_STORAGE_PATH=./data/masks
 
# Tip visualisation photo storage
TIP_PHOTO_STORAGE_PATH=./data/tips

# Path to the directory containing .keras model weight files.
# Relative to the project root when running locally; adjust for Docker mounts.
NPEC_ARTIFACT_DIR=src/npec_cv/artifacts/models

# Directory where generated segmentation mask images are written.
# /tmp is fine for development; use a persistent volume in production.
NPEC_MASK_OUTPUT_DIR=/tmp/npec_masks

# Identifier for the model version currently loaded for inference.
# Should match the "version" field in the model_versions table.
NPEC_MODEL_VERSION=unet-npec-v1.0.0

# Directory where confirmed annotation masks are stored.
NPEC_ANNOTATION_MASK_DIR=/tmp/npec_annotation_masks

# Total storage capacity of the lab environment in terabytes.
# Reported by GET /overview/status as data_collected_tb context.
NPEC_STORAGE_CAPACITY_TB=10.0

# Path to the training script.
# The script is responsible for training and writing per-epoch metrics.
NPEC_TRAINING_SCRIPT=/app/scripts/train_and_report.py

# Path to the directory with validation images
NPEC_VALIDATION_DIR=/app/data/validation

# Retraining threshold - number of confirmed predictions + incorrect
# feedback signals required to trigger automatic retraining.
RETRAIN_MIN_SAMPLES=10

# Minimum absolute F1 improvement required for a new model to be
# registered after training. 0.01 = model must improve by at least 1%.
MODEL_PROMOTION_MIN_IMPROVEMENT=0.01

# FRONTEND

# Base API URL used by the Vite/React frontend to reach the backend.
# For local development this points to localhost; update for deployed environments.
VITE_API_URL=http://localhost:8000/api/v1

# CORS

# Comma-separated list of allowed origins for the FastAPI CORS middleware.
# Add your frontend URL here (local, on-prem, or cloud).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AZURE ML

# Azure subscription ID for ML workspace authentication.
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Azure resource group containing the ML workspace.
AZURE_RESOURCE_GROUP=your-resource-group-here

# Name of the Azure ML workspace.
AZURE_ML_WORKSPACE=your-workspace-name-here

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=npec-artifacts
MINIO_SECURE=false
MINIO_PRESIGN_TTL=604800 
