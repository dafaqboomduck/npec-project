# =========================================
# Stage: Development (Vite React + TypeScript)
# =========================================
# Matches the Node version used in frontend-ci.yml
FROM node:20-alpine AS dev

# Set working directory inside the container
WORKDIR /app

# Copy package files first to leverage Docker layer caching.
# Dependencies are only reinstalled when package*.json changes.
COPY package*.json ./

# Install all dependencies (including devDependencies for hot reload)
RUN npm install

# Copy the rest of the application source code
COPY . .

# Default backend target for Docker Desktop (Windows/Mac).
# On Linux replace with http://172.17.0.1:8000.
# Override at runtime via --env-file .env or -e BACKEND_TARGET=...
ENV BACKEND_TARGET=http://host.docker.internal:8000


# Ensure the non-root "node" user owns the files to prevent
# permission errors when Vite writes cache files at runtime
RUN chown -R node:node /app

# Switch to non-root user for security
USER node

# Expose the Vite dev server port
EXPOSE 5173

# Start the Vite dev server bound to all interfaces so it is
# reachable from the host machine (or other containers)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
